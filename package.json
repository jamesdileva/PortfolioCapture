{
  "name": "portfolio-auto-recorder",
  "version": "0.1.0",
  "description": "Local-first desktop utility that automatically captures lightweight portfolio evidence",
  "main": "apps/desktop/electron/dist/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite --config apps/desktop/renderer/vite.config.ts",
    "dev:electron": "node scripts/build-electron.mjs && electron apps/desktop/electron/dist/main.js",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build --config apps/desktop/renderer/vite.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "dist": "electron-builder",
    "test": "vitest run",
    "test:e2e": "npm run build && npx playwright test",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  }
}
